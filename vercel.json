{
  "headers": [
    {
      "source": "/.well-known/(apple-app-site-association|assetlinks.json)",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/r/:slug", "destination": "/api/r?slug=:slug" },
    { "source": "/((?!api/|\\.well-known/).*)", "destination": "/index.html" }
  ]
}
