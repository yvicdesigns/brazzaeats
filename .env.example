# ============================================================
# BrazzaEats — Variables d'environnement
# Copiez ce fichier en .env.local et renseignez vos valeurs.
# Ne commitez jamais .env.local dans git.
# ============================================================

# Supabase — trouvez ces valeurs dans : Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ Ne JAMAIS ajouter la clé service_role ici avec un préfixe VITE_ —
# Vite l'embarquerait en clair dans le bundle livré au navigateur.
# La clé service_role se configure UNIQUEMENT côté serveur, comme secret
# de l'edge function admin-users :
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=eyJ...
